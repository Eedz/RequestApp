<UserControl x:Class="RequestApp.RequestEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RequestApp.Models"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="1000" Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="115"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <ComboBox Grid.Row="0" ItemsSource="{Binding StatusList}" SelectedItem="{Binding Status}" Grid.Column="0" Margin="3" HorizontalAlignment="Left" Width="150"/>

            <!-- Requester(s) -->
        <TextBlock Text="Add Requester(s)" Grid.Row="1" Grid.Column="0" FontWeight="Bold"/>

        <DockPanel Grid.Column="0" Grid.Row="2" Margin="3,0,3,0" >
            <ComboBox ItemsSource="{Binding RequesterNames}" DisplayMemberPath="ReversedFullName" SelectedItem="{Binding SelectedRequester, Mode=TwoWay}" Width="150" DockPanel.Dock="Left" />
            <Button Content="+" Command="{Binding AddRequesterCommand}" CommandParameter="{Binding SelectedRequester}" Width="35"/>
        </DockPanel>
        <ListBox  x:Name="RequestersListBox" Grid.Column="0" Grid.Row="3" Grid.RowSpan="8" MinHeight="200" ItemsSource="{Binding Requesters}" Margin="3" VerticalAlignment="Top">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="1" Height="32">
                        <TextBlock Text="{Binding ReversedFullName}" Margin="2,2,10,2" VerticalAlignment="Center"/>
                        <Button Content="X" VerticalContentAlignment="Top" Height="30" Command="{Binding DataContext.RemoveRequesterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!-- Other Data -->
        <TextBlock Text="Authorized By: " Grid.Row="0" Grid.Column="1" FontWeight="Bold" Margin="3,0" HorizontalAlignment="Right"/>
        <TextBox Text="{Binding AuthorizedBy}" Grid.Column="2" Grid.Row="0"/>
        <TextBlock Text="Expiry Date: " Grid.Row="1" Grid.Column="1" FontWeight="Bold" Margin="3,0" HorizontalAlignment="Right"/>
        <DatePicker SelectedDate="{Binding ExpiryDate}" Grid.Column="2" Grid.Row="1"/>
        <TextBlock Text="Last Signed Date: " Grid.Row="2" Grid.Column="1" FontWeight="Bold" Margin="3,0" HorizontalAlignment="Right"/>
        <DatePicker SelectedDate="{Binding LatestSigning}" Grid.Column="2" Grid.Row="2"/>
        <TextBlock Text="Internal/External: " Grid.Row="3" Grid.Column="1" FontWeight="Bold" Margin="3,0" HorizontalAlignment="Right"   />
        <ComboBox ItemsSource="{Binding InternalExternalList}" SelectedItem="{Binding InternalExternal}" Grid.Column="2" Grid.Row="3"/>

        <!-- Data Format -->
        <TextBlock Text="Data Format: " Grid.Row="4" Grid.Column="1" FontWeight="Bold" Margin="3,0" HorizontalAlignment="Right"/>
        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="2">
            <CheckBox Content="SAS" IsChecked="{Binding DataFormatSAS}" Margin="3"/>
            <CheckBox Content="SPSS" IsChecked="{Binding DataFormatSPSS}" Margin="3"/>
            <CheckBox Content="STATA" IsChecked="{Binding DataFormatSTATA}" Margin="3"/>
            <CheckBox Content="Other" IsChecked="{Binding DataFormatOther}" Margin="3"/>
            <TextBox Text="{Binding DataFormatOtherDescription}" Width="75" Margin="3" IsEnabled="{Binding DataFormatOther}"/>
        </StackPanel>

        <TextBlock Text="Notes: " Grid.Row="5" Grid.Column="1" FontWeight="Bold" Margin="3,0" HorizontalAlignment="Right"/>
        <TextBox Text="{Binding Notes}" Grid.Column="2" Grid.Row="5" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
    
        <!-- Save/Cancel buttons -->
        <StackPanel Grid.Row="6" Grid.Column="2">
            <Button Content="Save" Command="{Binding SaveCommand}" Margin="5"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="5"/>
        </StackPanel>
        
        
        <!-- Data Sets -->
        <StackPanel Grid.Column="3" >
            <TextBlock Text="Data Sets" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>
        <ListBox  x:Name="DataSetsListBox" Grid.Column="3" Grid.Row="1" Grid.RowSpan="5" ItemsSource="{Binding DataSets}" Margin="3,0,3,0" MinHeight="205" MaxHeight="225" VerticalAlignment="Top">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Margin="2,2,10,2" VerticalAlignment="Center"/>
                        <Button Content="x" VerticalContentAlignment="Top" Height="25" Command="{Binding DataContext.RemoveDataSetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!-- Subset Data Set -->
        <StackPanel Grid.Row="8" Grid.Column="3" Grid.ColumnSpan="2" Margin="2,0,3,0">
            <CheckBox   Width="75" HorizontalAlignment="Left" IsChecked="{Binding PartialDataSets}"/>
            <TextBlock  TextWrapping="Wrap" Text="Click here if any dataset is only partially requested (e.g. specific country or variables)"/>
        </StackPanel>
        
        <!-- Add/Remove Data Set buttons -->
        <Button Grid.Column="4" Grid.Row="1" Content="&lt;&lt;" Margin="0" VerticalContentAlignment="Center" Command="{Binding AddDataSetCommand}" CommandParameter="{Binding SelectedItem, ElementName=AvailableDataSetsListBox}"/>
        <Button Grid.Column="4" Grid.Row="2" Content=">>" Margin="0" Command="{Binding RemoveDataSetCommand}" CommandParameter="{Binding SelectedItem, ElementName=DataSetsListBox}" Visibility="Hidden"/>

        <!-- Full List of Data Sets -->
        <StackPanel Grid.Column="5" >
            <TextBlock Text="All Data Sets" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>

        <ListBox x:Name="AvailableDataSetsListBox" Grid.Column="5" Grid.Row="1" Grid.RowSpan="8" ItemsSource="{Binding FilteredDataSets}" Margin="3,0,3,0" MinHeight="225" MaxHeight="225" VerticalAlignment="Top">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" Margin="5"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Full List of Projects (for filtering) -->
        <StackPanel Grid.Column="6" >
            <TextBlock Text="Projects" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>

        <ListBox x:Name="AvailableProjectsListBox" Grid.Column="6" Grid.Row="1" Grid.RowSpan="8" ItemsSource="{Binding AvailableProjects}" SelectedItem="{Binding SelectedProject}"
                 Margin="3,0,3,0" MinHeight="225" MaxHeight="225" VerticalAlignment="Top">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Margin="5"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
