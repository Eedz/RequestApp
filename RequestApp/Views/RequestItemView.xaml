<UserControl x:Class="RequestApp.RequestItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RequestApp"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="1050" Height="160" Background="{StaticResource CardBorderBrush}">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>

                <DataTrigger Binding="{Binding Status}"
                             Value="Finished">

                    <Setter Property="Opacity"
                            Value="0.45"/>

                </DataTrigger>

            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid>
        <Border Style="{StaticResource CardHoverStyle}">
            <StackPanel Orientation="Horizontal">


                <StackPanel Margin="0" Width="175">
                    <TextBlock d:Text="Requester's Name" Text="{Binding Requester.ReversedFullName}" FontWeight="Bold" FontSize="14"/>
                    <TextBlock d:Text="Affiliation" Text="{Binding Requester.Affiliation}" TextWrapping="Wrap"/>
                    <TextBlock d:Text="Requester's Email" Text="{Binding Requester.Email}"/>
                    <TextBlock d:Text="Country Team" Text="{Binding Requester.CountryTeamMember, StringFormat='Country Team: {0}'}"/>
                    <TextBlock d:Text="Website?" Text="{Binding Requester.WebsiteMember, StringFormat='Website Member: {0}'}"/>
                    <CheckBox Content="Data User?" IsChecked="{Binding Requester.DataUser}" />
                </StackPanel >

                <StackPanel Margin="0" Width="175">
                    <TextBlock d:Text="Latest Signing" Text="{Binding LatestSigning, StringFormat='Latest Signing: {0:d}'}" FontWeight="Bold" FontSize="14"/>
                    
                </StackPanel>
                <StackPanel  Margin="0" Width="125">
                    <TextBlock HorizontalAlignment="Center">
                        <Run Text="Data Sets" FontWeight="Bold" />
                        <Run Text="{Binding DataSetCount, StringFormat=' ({0})', Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <ScrollViewer Height="100">
                        <ItemsControl ItemsSource="{Binding DataSets}"   Background="Transparent" >
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="1" HorizontalAlignment="Center" CornerRadius="5" Background="{StaticResource AccentBrush}">
                                        <TextBlock Text="{Binding Name}" Margin="5" Foreground="White"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
                <StackPanel Width="200" Margin="0">
                    <TextBlock d:Text="Expiry date" Text="{Binding ExpiryDate, StringFormat='Expires: {0:d}'}"/>
                    <TextBlock d:Text="Authorized by Mary T" Text="{Binding AuthorizedBy, StringFormat='Authorization: {0}'}"/>
                    <TextBlock d:Text="Internal/external" Text="{Binding InternalExternal}"/>
                </StackPanel>
                <StackPanel Width="200" Margin="0">
                    <TextBlock d:Text="Notes" Text="{Binding Notes, StringFormat='Notes: {0}'}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Margin="0" Width="75">
                    <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,2"/>
                    <Button Content="Email" Command="{Binding EmailCommand}" Margin="1"/>
                    <Button Content="Edit" Command="{Binding EditCommand}" Margin="1"/>
                    <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="1"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Popup IsOpen="{Binding IsEditing}" StaysOpen="True" Placement="Center">
            <Border Background="{StaticResource AppBackgroundBrush}" BorderBrush="Black" BorderThickness="1" Padding="10">
                <local:RequestEditorView DataContext="{Binding EditorViewModel}" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
